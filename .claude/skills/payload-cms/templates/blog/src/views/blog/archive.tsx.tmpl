// 📖 Docs: obsidian/backend/cms-payload.md
/**
 * The shared page of a list of posts — a topic or an author: the trail, one
 * `<h1>`, the intro, every post in it. Topic and author pages differ only in
 * what they introduce and the JSON-LD they carry.
 */
import type { ReactNode } from "react";

import type { Crumb } from "@/cms/docs";
import { Breadcrumbs } from "@/components/cms/breadcrumbs";
import { BLOG_COPY } from "@/data/mocks/blog";
import type { Post } from "@/payload-types";

import { PostCard } from "./post-card";

interface ArchiveProps {
  crumbs: readonly Crumb[];
  heading: string;
  /** The intro under the heading — a topic's introduction, an author's bio. */
  intro?: ReactNode;
  /** The posts section's heading, e.g. "Articles on Pricing". */
  listHeading: string;
  posts: readonly Post[];
  /** One JSON-LD graph for the page. */
  jsonLd: ReactNode;
}

export const Archive = ({ crumbs, heading, intro, listHeading, posts, jsonLd }: ArchiveProps) => (
  <div className="min-h-lvh w-full bg-background font-sans text-foreground">
    {jsonLd}
    <header className="mx-auto w-full max-w-[64rem] px-4 pb-10 pt-24 md:px-6 md:pt-28 xl:px-8">
      <Breadcrumbs crumbs={crumbs} label={BLOG_COPY.breadcrumb} />
      <h1 className="mt-6 text-4xl font-medium leading-display">{heading}</h1>
      {intro}
    </header>
    <main className="mx-auto w-full max-w-[64rem] px-4 pb-24 md:px-6 xl:px-8">
      <section aria-labelledby="archive-posts">
        <h2 id="archive-posts" className="text-2xl font-medium leading-display">
          {listHeading}
        </h2>
        {posts.length === 0 ? (
          <p className="mt-4 opacity-80">{BLOG_COPY.empty}</p>
        ) : (
          <ul className="mt-6 grid gap-10 md:grid-cols-2">
            {posts.map((post) => (
              <li key={post.id}>
                <PostCard post={post} level="h3" />
              </li>
            ))}
          </ul>
        )}
      </section>
    </main>
  </div>
);
