// 📖 Docs: obsidian/backend/cms-payload.md → The guide
/**
 * The editor's guide, as content: which admin entry edits which screen of the
 * site, what each field is, and what SEO and Analytics show.
 *
 * Plain data rendered by a server component, with no client code — the page is
 * read, not interacted with. The screenshots are the site's own screens, shot
 * at 1440 × 900 and kept in `public/admin-guide/`; re-shoot them when a screen
 * changes, the guide shows whatever is there.
 *
 * Kept apart from `guide-view.tsx` so the content can be rendered without
 * Payload's template (a check, a preview) and the view stays a frame.
 */

/** One admin entry — a global, a tab, a collection — and what it edits. */
interface Entry {
  /** The sidebar path, e.g. "Home page → 1 · Hero". */
  where: string;
  /** What the editor sees on the site. */
  title: string;
  /** The screenshot's basename in `public/admin-guide/`. */
  shot?: string;
  /** What this entry edits, one field or group per line. */
  fields: string[];
  /** Things worth knowing before pressing Save. */
  notes?: string[];
}

interface Chapter {
  id: string;
  title: string;
  lead: string;
  entries: Entry[];
}

/** A short, screen-free list — the general rules and the settings. */
interface Plain {
  id: string;
  title: string;
  lead?: string;
  points: string[];
}

const HEADLINE = "Headline in two parts: the dark words and the highlighted words";
const EYEBROW = "Eyebrow (the small line above the headline)";

/**
 * PROJECT CONFIG — the general rules. Keep what is true of this admin, cut the
 * rest; each point answers a question an editor would otherwise ask.
 */
